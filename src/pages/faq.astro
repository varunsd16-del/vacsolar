---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQ, { faqList } from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
---

<BaseLayout
  title="Rooftop Solar Frequently Asked Questions (FAQ) | VAC Solar"
  description="Comprehensive 18-part technical FAQ covering solar fundamentals, system sizing, components, shading, site surveys, net metering, and maintenance."
  faqSchema={faqList}
>
  <!-- Page Header Banner -->
  <section class="bg-slate-900 text-white py-16 lg:py-20 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-4">
        <span class="px-3 py-1 rounded bg-slate-800 border border-slate-700 text-solar-400 text-xs font-mono font-bold uppercase tracking-wider">
          Structured Knowledge Base
        </span>
        <h1 class="text-4xl sm:text-5xl font-extrabold font-heading text-white tracking-tight">
          Solar Engineering FAQs
        </h1>
        <p class="text-lg text-slate-300 leading-relaxed">
          Comprehensive, multi-paragraph factual answers designed for solar buyers and SnapServe AI voice agent consultation.
        </p>
      </div>
    </div>
  </section>

  <!-- Full FAQ Component -->
  <FAQ />

  <CTA />
</BaseLayout>

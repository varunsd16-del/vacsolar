---
---

<section class="py-20 bg-slate-900 text-white relative overflow-hidden">
  <!-- Subtle Solar Glow Background -->
  <div class="absolute inset-0 opacity-20 bg-[radial-gradient(#f59e0b_1px,transparent_1px)] [background-size:32px_32px]"></div>
  <div class="absolute -bottom-20 -right-20 w-[400px] h-[400px] bg-solar-500/20 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10 space-y-6">
    <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-slate-800 border border-slate-700 text-solar-400 text-xs font-bold uppercase tracking-wider">
      Engineered For Long-Term Reliability
    </div>

    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold font-heading text-white tracking-tight leading-tight">
      Ready to Explore Solar for Your Property?
    </h2>

    <p class="text-base sm:text-xl text-slate-300 max-w-2xl mx-auto leading-relaxed">
      Get a professional technical consultation and understand what solar could look like for your home or business.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
      <a
        href="/#lead-form"
        class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 rounded-xl text-base font-bold text-slate-950 bg-solar-400 hover:bg-solar-500 shadow-xl hover:shadow-solar-glow transition-all duration-200"
      >
        Get Free Consultation
        <svg class="w-5 h-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>

      <a
        href="/solar-site-survey"
        class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 rounded-xl text-base font-semibold text-slate-200 bg-slate-800/90 hover:bg-slate-800 border border-slate-700 hover:border-slate-600 transition-all duration-200"
      >
        Book Site Survey
      </a>
    </div>

    <div class="pt-6 text-xs text-slate-400 flex items-center justify-center gap-6">
      <span>✓ Qualified Engineers</span>
      <span>✓ No Fake Guarantees</span>
      <span>✓ SnapServe AI Consultation Ready</span>
    </div>
  </div>
</section>

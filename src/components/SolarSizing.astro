---
const sizingFactors = [
  { title: 'Electricity Consumption (kWh)', desc: 'Actual monthly kilowatt-hour (unit) usage from utility bills over 6-12 months rather than just rupee billing amounts.' },
  { title: 'Daytime Usage Pattern', desc: 'The proportion of electrical loads running during peak sunlight hours (9 AM - 4 PM) vs night hours.' },
  { title: 'Available Unshaded Roof Area', desc: 'Shadow-free usable square footage. Approx 80-100 sq.ft of unshaded roof space is generally required per 1 kW of crystalline solar panels.' },
  { title: 'Roof Orientation & Azimuth', desc: 'South-facing roofs receive maximum solar irradiance. East/West facing roofs may require structural tilt adjustments or slightly larger panel arrays.' },
  { title: 'Electrical Connection Phase', desc: 'Single-phase connections typically support solar capacities up to 3 kW or 5 kW depending on DISCOM norms; larger systems require three-phase meters.' },
  { title: 'Sanctioned Grid Load Limit', desc: 'Solar PV capacity is regulated relative to your sanctioned connected load limit with the local utility provider.' },
  { title: 'Future Expansion Needs', desc: 'Planned additions like electric vehicles (EVs), heat pumps, or commercial machinery.' },
  { title: 'Roof Structural Load Rating', desc: 'Load-bearing strength of the slab or shed structure to safely support panel deadweight and wind ballast.' }
];
---

<section id="solar-sizing" class="py-20 bg-white border-b border-slate-200/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="max-w-3xl mx-auto text-center mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-solar-100 border border-solar-200 text-solar-900 text-xs font-bold uppercase tracking-wider mb-4">
        Engineering Methodology
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold font-heading text-slate-900 tracking-tight">
        How Is a Solar System Sized?
      </h2>
      <p class="text-base sm:text-lg text-slate-600 mt-4 leading-relaxed">
        Accurate solar PV sizing requires evaluating multiple engineering variables rather than relying on crude financial assumptions.
      </p>
    </div>

    <!-- Critical Notice Box regarding bill assumptions -->
    <div class="mb-12 p-6 rounded-2xl bg-amber-50 border border-amber-200 text-slate-900 shadow-sm">
      <div class="flex items-start gap-4">
        <div class="w-10 h-10 rounded-xl bg-solar-400 text-slate-950 flex items-center justify-center font-bold text-xl shrink-0 mt-0.5">
          ⚠️
        </div>
        <div>
          <h3 class="text-lg font-bold font-heading text-slate-900">
            Important: Why System Sizing Is Not Determined From Electricity Bill Alone
          </h3>
          <p class="text-sm text-slate-700 mt-1 leading-relaxed">
            Electricity billing amounts fluctuate based on slab tariffs, seasonal AC usage, fuel surcharge adjustments, and fixed demand charges. A simple formula such as <span class="font-semibold text-slate-900">"₹5,000 bill = exactly X kW"</span> is inaccurate. Final system capacity must always be validated through technical site assessment, actual unit (kWh) consumption analysis, and roof shade plotting.
          </p>
        </div>
      </div>
    </div>

    <!-- 8 Sizing Factors Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
      {sizingFactors.map((factor, idx) => (
        <div class="p-5 rounded-xl bg-slate-50 border border-slate-200 hover:border-solar-400/80 transition-colors">
          <div class="text-xs font-mono font-bold text-solar-700 mb-2">VARIABLE 0{idx + 1}</div>
          <h4 class="text-base font-bold text-slate-900 mb-1 font-heading">{factor.title}</h4>
          <p class="text-xs text-slate-600 leading-relaxed">{factor.desc}</p>
        </div>
      ))}
    </div>

    <!-- Interactive Indicative Estimator Tool -->
    <div class="rounded-2xl bg-slate-900 text-white p-6 sm:p-10 shadow-2xl border border-slate-800">
      <div class="max-w-2xl mx-auto text-center mb-8">
        <span class="text-xs font-mono font-bold text-solar-400 uppercase tracking-widest">Indicative Calculator</span>
        <h3 class="text-2xl sm:text-3xl font-bold font-heading text-white mt-1">
          Explore Indicative Solar Sizing Ranges
        </h3>
        <p class="text-xs sm:text-sm text-slate-400 mt-2">
          Select your average monthly electricity bill range to view general indicative rooftop area and generation expectations.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 max-w-3xl mx-auto mb-8">
        <button type="button" data-bill="small" class="sizing-tab p-4 rounded-xl border border-slate-700 bg-slate-800 text-left hover:border-solar-400 transition-colors active">
          <div class="text-xs font-bold text-solar-400">RESIDENTIAL SMALL</div>
          <div class="text-sm font-bold text-white mt-0.5">₹2,000 - ₹5,000 / mo</div>
        </button>

        <button type="button" data-bill="medium" class="sizing-tab p-4 rounded-xl border border-slate-700 bg-slate-800 text-left hover:border-solar-400 transition-colors">
          <div class="text-xs font-bold text-solar-400">RESIDENTIAL MEDIUM</div>
          <div class="text-sm font-bold text-white mt-0.5">₹5,000 - ₹12,000 / mo</div>
        </button>

        <button type="button" data-bill="large" class="sizing-tab p-4 rounded-xl border border-slate-700 bg-slate-800 text-left hover:border-solar-400 transition-colors">
          <div class="text-xs font-bold text-solar-400">COMMERCIAL / HIGH</div>
          <div class="text-sm font-bold text-white mt-0.5">Above ₹15,000 / mo</div>
        </button>
      </div>

      <!-- Output Panel -->
      <div id="sizing-output-panel" class="max-w-3xl mx-auto p-6 rounded-xl bg-slate-950 border border-slate-800 grid grid-cols-1 sm:grid-cols-3 gap-6 text-center">
        <div>
          <div class="text-xs text-slate-400 font-medium">Indicative System Range</div>
          <div id="output-capacity" class="text-2xl font-bold font-heading text-solar-400 mt-1">3 kW - 5 kW</div>
        </div>
        <div>
          <div class="text-xs text-slate-400 font-medium">Approx Shadow-Free Roof</div>
          <div id="output-area" class="text-2xl font-bold font-heading text-white mt-1">250 - 450 sq.ft</div>
        </div>
        <div>
          <div class="text-xs text-slate-400 font-medium">Est. Daily Generation Range</div>
          <div id="output-units" class="text-2xl font-bold font-heading text-cyan-400 mt-1">12 - 20 Units / day</div>
        </div>
      </div>

      <div class="mt-6 text-center">
        <p class="text-[11px] text-slate-400 italic mb-4 max-w-xl mx-auto">
          * Note: Values above are indicative benchmarks under standard irradiance. Exact system capacity and generation require verified site engineering survey.
        </p>
        <a
          href="/#lead-form"
          class="inline-flex items-center justify-center px-6 py-3 rounded-xl font-bold text-slate-950 bg-solar-400 hover:bg-solar-500 transition-colors"
        >
          Book Technical Site Assessment
        </a>
      </div>
    </div>

  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('.sizing-tab');
    const capEl = document.getElementById('output-capacity');
    const areaEl = document.getElementById('output-area');
    const unitsEl = document.getElementById('output-units');

    const dataMap: Record<string, { capacity: string; area: string; units: string }> = {
      small: { capacity: '3 kW - 5 kW', area: '250 - 450 sq.ft', units: '12 - 20 Units / day' },
      medium: { capacity: '5 kW - 10 kW', area: '450 - 900 sq.ft', units: '20 - 40 Units / day' },
      large: { capacity: '10 kW - 50+ kW', area: '900 - 4500+ sq.ft', units: '40 - 200+ Units / day' },
    };

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => {
          t.classList.remove('border-solar-400', 'bg-slate-700');
          t.classList.add('border-slate-700', 'bg-slate-800');
        });
        tab.classList.remove('border-slate-700', 'bg-slate-800');
        tab.classList.add('border-solar-400', 'bg-slate-700');

        const key = tab.getAttribute('data-bill') || 'small';
        const info = dataMap[key];
        if (info && capEl && areaEl && unitsEl) {
          capEl.textContent = info.capacity;
          areaEl.textContent = info.area;
          unitsEl.textContent = info.units;
        }
      });
    });
  });
</script>

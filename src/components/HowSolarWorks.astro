---
const workflowSteps = [
  {
    step: '01',
    title: 'Sunlight Irradiance',
    subtitle: 'Photons hit solar panel surface',
    description: 'Solar radiation (photons) strikes the semiconductor silicon solar cells during daylight hours. Higher light intensity and optimal sun angle maximize energy absorption.'
  },
  {
    step: '02',
    title: 'Solar Panel Generation',
    subtitle: 'Photovoltaic (PV) conversion',
    description: 'The photovoltaic effect inside solar cells excites electrons, generating Direct Current (DC) electricity across the panel array.'
  },
  {
    step: '03',
    title: 'DC Electricity Flow',
    subtitle: 'Conducted via DC solar cables',
    description: 'Generated DC power is safely routed through UV-resistant, double-insulated solar cables through DC isolator switches to the solar inverter.'
  },
  {
    step: '04',
    title: 'Solar Inverter Conversion',
    subtitle: 'DC to AC conversion & MPPT',
    description: 'The inverter converts DC voltage into synchronized Alternating Current (AC) electricity matching your grid frequency (50 Hz) and voltage.'
  },
  {
    step: '05',
    title: 'AC Electricity Distribution',
    subtitle: 'Protected AC distribution board',
    description: 'AC power flows through safety breakers and surge protection devices into your property’s main electrical distribution panel.'
  },
  {
    step: '06',
    title: 'Building Load Consumption',
    subtitle: 'Powers appliances & machinery',
    description: 'Your lights, fans, air conditioners, machinery, and equipment consume clean solar power first, reducing immediate electricity draw from the grid.'
  },
  {
    step: '07',
    title: 'Grid Sync & Bi-Directional Export',
    subtitle: 'Net Metering / Export flow',
    description: 'When solar generation exceeds instant property consumption, surplus AC energy flows back to the utility grid through a bi-directional Net Meter.'
  }
];
---

<section id="how-solar-works" class="py-20 bg-white border-b border-slate-200/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="max-w-3xl mx-auto text-center mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-solar-100 border border-solar-200 text-solar-900 text-xs font-bold uppercase tracking-wider mb-4">
        Photovoltaic Process
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold font-heading text-slate-900 tracking-tight">
        How Rooftop Solar Generates Electricity
      </h2>
      <p class="text-base sm:text-lg text-slate-600 mt-4 leading-relaxed">
        Understand the step-by-step conversion process from photon absorption to household appliance power and grid export.
      </p>
    </div>

    <!-- Visual Flow Diagram Image -->
    <div class="mb-16">
      <div class="rounded-2xl overflow-hidden shadow-xl border border-slate-200">
        <img
          src="/images/flowdiargam.webp"
          alt="Complete Energy Conversion Flow Cycle – Sunlight → Solar Panels → DC Flow → Solar Inverter → AC Power → Building Loads → Utility Grid"
          class="w-full h-auto object-contain"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>

    <!-- Step Grid Explanations -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {workflowSteps.map((s) => (
        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 hover:border-solar-400/80 transition-all duration-200 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="font-mono text-xs font-bold px-2.5 py-1 rounded bg-slate-900 text-solar-400">
                STAGE {s.step}
              </span>
            </div>
            <h3 class="text-xl font-bold font-heading text-slate-900 mb-1">
              {s.title}
            </h3>
            <div class="text-xs font-semibold text-solar-700 mb-3">{s.subtitle}</div>
            <p class="text-sm text-slate-600 leading-relaxed">
              {s.description}
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

---
const componentsData = [
  {
    category: 'Photovoltaic Array',
    title: 'Solar Panels (PV Modules)',
    image: '/images/component_pv_modules.png',
    alt: 'High-efficiency monocrystalline solar panels PV modules on rooftop',
    summary: 'Solar panels convert incident sunlight into direct current (DC) electricity via semiconductor solar cells.',
    technicalKnowledge: [
      { key: 'Photovoltaic Generation', detail: 'Silicon cells absorb photons, displacing electrons to generate electrical current proportional to light intensity.' },
      { key: 'Orientation & Azimuth', detail: 'In the Northern Hemisphere, panels ideally face true South to maximize sun exposure throughout the day.' },
      { key: 'Tilt Angle', detail: 'Optimal tilt angle is generally aligned close to the site latitude (e.g. 10°-15° in Tamil Nadu) to maximize annual yield.' },
      { key: 'Shading Considerations', detail: 'Even partial shading from trees, parapets, or water tanks reduces string current output. Bypass diodes help mitigate local shading losses.' },
      { key: 'Temperature Coefficient', detail: 'Solar panel efficiency decreases slightly as ambient cell temperature rises above 25°C. High quality modules feature low negative temperature coefficients.' }
    ]
  },
  {
    category: 'Power Electronics',
    title: 'Solar Inverters',
    image: '/images/component_solar_inverter.png',
    alt: 'Wall-mounted string solar inverter with digital status LCD screen',
    summary: 'The central power conversion unit that converts DC power generated by solar panels into grid-synchronized AC electricity.',
    technicalKnowledge: [
      { key: 'DC to AC Conversion', detail: 'Transforms variable DC voltage into clean 230V single-phase or 415V three-phase AC electricity at 50Hz.' },
      { key: 'MPPT Technology', detail: 'Maximum Power Point Tracking (MPPT) continuously adjusts operating voltage to extract maximum possible wattage under changing irradiance.' },
      { key: 'Grid Synchronization & Anti-Islanding', detail: 'Inverters match utility grid frequency and automatically disconnect during grid outages for maintenance crew safety.' },
      { key: 'Selection Criteria', detail: 'Inverter capacity must match total string DC input voltage, short-circuit current ratings, and grid connection phase requirements.' }
    ]
  },
  {
    category: 'Structural Engineering',
    title: 'Mounting Structures & Hardware',
    image: '/images/component_mounting_structure.png',
    alt: 'Hot-dip galvanized steel solar mounting structures and clamps',
    summary: 'Engineered metal frameworks that securely anchor solar modules to roofs or ground foundations.',
    technicalKnowledge: [
      { key: 'Structural Integrity', detail: 'Structures are designed to withstand high wind velocity loads (up to 150-180 km/h) based on localized wind zone standards.' },
      { key: 'Material & Corrosion Resistance', detail: 'Hot-dip galvanized iron (HDGI), anodized aluminum, or stainless steel fasteners prevent atmospheric rust and structural degradation.' },
      { key: 'Roof Mounting Types', detail: 'Non-penetrating ballasted mounts for RCC flat roofs, tin shed rail clamps for industrial metal roofs, or elevated legs for dual roof usage.' },
      { key: 'Tilt Optimization', detail: 'Fixed or adjustable seasonal tilt angle mounts optimize seasonal solar irradiation absorption.' }
    ]
  },
  {
    category: 'Electrical Safety',
    title: 'Electrical Protection & Safety Systems',
    image: '/images/component_electrical_safety.png',
    alt: 'Solar electrical safety distribution box with isolators and SPDs',
    summary: 'Comprehensive protective switchgear designed to isolate electrical faults and safeguard occupants and equipment.',
    technicalKnowledge: [
      { key: 'DC & AC Isolators', detail: 'Dedicated rotary switch isolators allow safe manual disconnection of DC panels and AC inverter circuits for maintenance.' },
      { key: 'Surge Protection Devices (SPD)', detail: 'Type 2 SPDs divert transient high-voltage surges from lightning strikes or grid fluctuations safely to earth.' },
      { key: 'Dual Earthing System', detail: 'Independent copper-bonded earthing pits separately ground DC module frames, inverter casings, and lightning arrestors.' },
      { key: 'Lightning Arrestors (LA)', detail: 'Early streamer emission (ESE) or conventional copper lightning rods provide atmospheric discharge path protection.' }
    ]
  },
  {
    category: 'Telemetry & Analytics',
    title: 'Monitoring & Performance Systems',
    image: '/images/component_monitoring_system.png',
    alt: 'Smart solar energy yield telemetry and real-time analytics monitor',
    summary: 'Digital monitoring modules that provide real-time visibility into system generation, efficiency, and diagnostic alerts.',
    technicalKnowledge: [
      { key: 'Energy Yield Analytics', detail: 'Tracks daily, monthly, and cumulative kilowatt-hours (kWh) produced by the solar installation.' },
      { key: 'Performance Ratio (PR)', detail: 'Compares actual kWh output against theoretical yield based on irradiance data to assess overall plant health.' },
      { key: 'Fault Diagnostics', detail: 'Sends automated notifications for inverter grid faults, string dropouts, or underperformance events.' },
      { key: 'Connectivity Options', detail: 'Uses Wi-Fi, Ethernet, or 4G IoT gateways for remote web app telemetry monitoring.' }
    ]
  }
];
---

<section id="solar-components" class="py-20 bg-slate-50 border-b border-slate-200/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="max-w-3xl mx-auto text-center mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-solar-100 border border-solar-200 text-solar-900 text-xs font-bold uppercase tracking-wider mb-4">
        Technical Knowledge Base
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold font-heading text-slate-900 tracking-tight">
        Core Solar PV System Components
      </h2>
      <p class="text-base sm:text-lg text-slate-600 mt-4 leading-relaxed">
        A reliable solar installation relies on five integrated subsystems. Explore the visual representation and technical fundamentals of each component.
      </p>
    </div>

    <!-- Components List -->
    <div class="space-y-10">
      {componentsData.map((item, idx) => (
        <div class="rounded-2xl bg-white border border-slate-200 p-6 sm:p-8 shadow-card-soft transition-all duration-300 hover:shadow-card hover:border-slate-300">
          
          <!-- Component Header -->
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6 pb-6 border-b border-slate-100">
            <div>
              <span class="text-xs font-mono font-bold text-solar-700 uppercase tracking-widest bg-solar-50 px-2.5 py-1 rounded-md border border-solar-200/60 inline-block mb-2">
                Component {idx + 1} • {item.category}
              </span>
              <h3 class="text-2xl sm:text-3xl font-bold font-heading text-slate-900">
                {item.title}
              </h3>
            </div>
            <p class="text-sm text-slate-600 max-w-lg md:text-right leading-relaxed">
              {item.summary}
            </p>
          </div>

          <!-- Component Body: Image + Technical Details -->
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            
            <!-- Left: Component Image -->
            <div class="lg:col-span-4 group relative overflow-hidden rounded-xl border border-slate-200 bg-slate-100 shadow-sm">
              <img 
                src={item.image} 
                alt={item.alt} 
                class="w-full h-64 lg:h-72 object-cover object-center group-hover:scale-105 transition-transform duration-500 ease-out" 
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-4">
                <span class="text-xs font-medium text-white/90 drop-shadow">
                  {item.title} Photo View
                </span>
              </div>
            </div>

            <!-- Right: Technical Knowledge Cards -->
            <div class="lg:col-span-8 grid grid-cols-1 sm:grid-cols-2 gap-4">
              {item.technicalKnowledge.map((tech) => (
                <div class="p-4 rounded-xl bg-slate-50 border border-slate-200/80 hover:bg-solar-50/50 hover:border-solar-200 transition-colors">
                  <div class="text-xs font-bold text-slate-900 mb-1.5 flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-solar-500 flex-shrink-0"></span>
                    {tech.key}
                  </div>
                  <p class="text-xs text-slate-600 leading-relaxed">
                    {tech.detail}
                  </p>
                </div>
              ))}
            </div>

          </div>

        </div>
      ))}
    </div>

  </div>
</section>

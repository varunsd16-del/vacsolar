---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  faqSchema?: Array<{ question: string; answer: string }>;
  lang?: string;
}

const {
  title = "VAC Solar | Smart Solar Solutions for Homes & Businesses",
  description = "Explore custom rooftop solar solutions for homes and businesses. Technical guidance on solar sizing, site surveys, solar components, Tamil Nadu site feasibility and savings with VAC Solar.",
  canonicalUrl = Astro.url.href,
  faqSchema = [],
  lang = "en"
} = Astro.props;

// Schema.org Organization markup
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "VAC SOLAR",
  "url": "https://vacsolar.com",
  "logo": "https://vacsolar.com/logo.svg",
  "description": "Smart solar solutions designed around your electricity usage, property and energy goals.",
  "knowsAbout": [
    "Rooftop Solar PV",
    "Solar Inverters",
    "Solar Net Metering",
    "Commercial Solar Systems",
    "Industrial Solar Systems",
    "Solar Feasibility & Site Assessment"
  ],
  "areaServed": "Tamil Nadu, India"
};

// Schema.org FAQPage markup if present
const faqJsonLd = faqSchema.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqSchema.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
} : null;
---

<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="canonical" href={canonicalUrl} />
  
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:site_name" content="VAC SOLAR" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />

  <!-- Schema.org Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  {faqJsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  )}

  <!-- SnapServe Lead Capture Script -->
  <script src="https://app.snapserve.ai/api/widget/lead-capture.js" data-token="07c189a3-4467-4d0b-a261-41ca58f2d0a1"></script>
</head>
<body class="bg-slate-50 text-slate-900 min-h-screen flex flex-col antialiased selection:bg-solar-100 selection:text-solar-900">
  <!-- Skip link for keyboard accessibility -->
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:p-4 focus:bg-solar-500 focus:text-slate-950 focus:font-bold">
    Skip to main content
  </a>

  <Header />
  
  <main id="main-content" class="flex-grow">
    <slot />
  </main>

  <Footer />
</body>
</html>
